# Copy this file to ".env" and fill in real values for local development.
# All values are read in piki_ora_clinic/settings.py via python-decouple.

# Required: a long random string. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-me-with-a-long-random-string

# Local dev: True. Production: False.
DEBUG=True

# Comma-separated list of hosts. For Vercel, append ".vercel.app".
ALLOWED_HOSTS=localhost,127.0.0.1

# Database URL.
#   - Leave unset for SQLite (default for local dev)
#   - On Vercel set this to your Postgres connection string, e.g.
#     postgres://USER:PASS@HOST:5432/DBNAME
# DATABASE_URL=postgres://user:pass@host:5432/dbname
